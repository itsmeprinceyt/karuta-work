{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "copyAssets.ts"
  ]
}